# Copy to .env and fill in. .env is git-ignored.
# The key must be scoped to a workspace, and the account needs API credits.
ANTHROPIC_API_KEY=sk-ant-...replace-with-your-key

# --- Serving (src/config.py; used by the API) ---
# QDRANT_URL=http://localhost:6333
# QDRANT_PATH=qdrant_local          # local-file Qdrant instead of a server
# TROA_SEARCH_MODE=vector           # vector | hybrid (BM25 + dense, RRF)
# TROA_AGENTIC=false                # grade passages, rewrite the query and retry once
# TROA_RERANK=true                  # false: skip bge-reranker-large (2.24 GB), keep top 5 by retrieval score
# TROA_CALIBRATION=calibration/v1.json
# TROA_CACHE=true                   # exact-match answer cache (released answers only)
# TROA_CACHE_TTL=604800             # seconds
# REDIS_URL=redis://localhost:6379/0   # cache backend; in-memory when unset
# TROA_QUERY_LOG=logs/queries.jsonl # one JSON line per answered question
